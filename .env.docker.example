# .env.docker.example — запуск через Docker

# Режим работы приложения
MODE=DEV

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_password
POSTGRES_DB=english_app

DATABASE_URL=postgresql+asyncpg://postgres:replace_with_password@db:5432/english_app

# JWT секрет
SECRET_KEY=replace_with_your_secret_key

# VK OAuth
VK_OAUTH_CLIENT_ID=replace_with_vk_client_id
VK_OAUTH_CLIENT_SECRET=replace_with_vk_client_secret
VK_OAUTH_SERVICE_KEY=replace_with_vk_service_key
VK_OAUTH_REDIRECT_URI=http://localhost/api/auth/callback/vkontakte

# Yandex Cloud
YANDEX_CLOUD_ACCESS_KEY=replace_with_access_key
YANDEX_CLOUD_SECRET_KEY=replace_with_secret_key

